@namespace HtmxBlazor.Web.Components.Fragments
@if (Results.Count > 0)
{
    <ul>
        @foreach (var fruit in Results)
        {
            <li>@fruit</li>
        }
    </ul>
}
else
{
    <p><em>No result for “@Query”.</em></p>
}

@code {
    public const string Route = "/fragments/search";

    private static readonly string[] Fruits =
    [
        "Apple", "Apricot", "Banana", "Blackberry", "Blueberry", "Cherry",
        "Grape", "Kiwi", "Lemon", "Mango", "Orange", "Peach", "Pear",
        "Pineapple", "Raspberry", "Strawberry", "Watermelon",
    ];

    [Parameter] public string? Query { get; set; }

    private IReadOnlyList<string> Results => string.IsNullOrWhiteSpace(Query)
        ? Fruits
        : Fruits.Where(f => f.Contains(Query, StringComparison.OrdinalIgnoreCase)).ToArray();
}
