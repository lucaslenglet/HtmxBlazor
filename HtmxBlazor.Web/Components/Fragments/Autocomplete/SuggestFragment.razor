@namespace HtmxBlazor.Web.Components.Fragments
@inherits HxComponentBase

@* An empty query renders nothing: the empty innerHTML swap clears the panel. *@
@if (!string.IsNullOrWhiteSpace(Query))
{
    <HxAutocompletePanel>
        @if (Matches.Count == 0)
        {
            <span class="hx-autocomplete-empty">No country matches “@Query”.</span>
        }
        @foreach (var country in Matches)
        {
            <HxAutocompleteOption Get="@PickUrl(country)"
                                  Target="@($"#{DemoAutocomplete.TargetId}")"
                                  Swap="HxSwap.OuterHtml">@country</HxAutocompleteOption>
        }
    </HxAutocompletePanel>
}

@code {
    public const string Route = "/fragments/demo-suggest";

    private static readonly string[] Countries =
    [
        "Argentina", "Australia", "Belgium", "Brazil", "Canada", "France",
        "Germany", "Iceland", "India", "Italy", "Japan", "Mexico",
        "Netherlands", "Norway", "Portugal", "Spain", "Sweden", "Switzerland",
    ];

    [Parameter] public string? Query { get; set; }

    private IReadOnlyList<string> Matches =>
        Countries.Where(c => c.Contains(Query!, StringComparison.OrdinalIgnoreCase)).ToArray();

    private static string PickUrl(string country)
        => $"{DemoAutocomplete.Route}?value={Uri.EscapeDataString(country)}";
}
