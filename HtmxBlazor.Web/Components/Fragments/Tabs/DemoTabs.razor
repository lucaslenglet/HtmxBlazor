@namespace HtmxBlazor.Web.Components.Fragments
<HxTabs Id="demo-tabs" Url="@Route" Active="@Active">
    <HxTab Key="overview" Title="Overview">
        <p>Only the <strong>active</strong> tab panel is rendered and sent over the wire.</p>
        <p><em>Rendered at @DateTime.Now.ToString("HH:mm:ss.fff")</em></p>
    </HxTab>
    <HxTab Key="details" Title="Details">
        <p>Clicking a tab GETs this same component with a different <code>?tab=</code> value, and htmx swaps the whole tab set (<code>outerHTML</code>).</p>
        <p><em>Rendered at @DateTime.Now.ToString("HH:mm:ss.fff")</em></p>
    </HxTab>
    <HxTab Key="settings" Title="Settings">
        <p>Tab state lives on the server — nothing is hidden in the DOM, no JavaScript toggles classes.</p>
        <p><em>Rendered at @DateTime.Now.ToString("HH:mm:ss.fff")</em></p>
    </HxTab>
</HxTabs>

@code {
    public const string Route = "/fragments/demo-tabs";

    [Parameter] public string? Active { get; set; }
}
