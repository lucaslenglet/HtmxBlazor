@inherits HxComponentBase

<ul id="demo-items" class="demo-items" @attributes="AdditionalAttributes">
    @{ var items = Snapshot(); }
    @if (items.Length == 0)
    {
        <li><em>Nothing left to delete.</em></li>
    }
    @foreach (var item in items)
    {
        <li>
            <span>@item</span>
            <HxButton Get="@($"{DemoConfirm.Route}?item={Uri.EscapeDataString(item)}")"
                      Target="@HxModalRoot.DefaultTarget">Delete…</HxButton>
        </li>
    }
</ul>

@code {
    private static readonly List<string> Items =
    [
        "Quarterly report",
        "Old backup",
        "Meeting notes",
        "Draft invoice",
    ];

    internal static void Remove(string item)
    {
        lock (Items)
        {
            Items.Remove(item);
        }
    }

    private static string[] Snapshot()
    {
        lock (Items)
        {
            return [.. Items];
        }
    }
}
