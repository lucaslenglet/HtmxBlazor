@namespace HtmxBlazor.Web.Components.Fragments
@inherits HxComponentBase

<span>You picked <strong>@Choice</strong>.</span>

@code {
    public const string Route = "/fragments/pick";

    [Parameter] public string? Choice { get; set; }

    protected override void OnInitialized()
    {
        if (IsHtmxRequest)
        {
            TriggerClientEvent(HxDropdown.EventClose);
        }
    }
}
