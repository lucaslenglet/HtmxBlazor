@namespace HtmxBlazor.Components
@inherits HxComponentBase

<div id="@Id" class="hx-dropdown" @attributes="AdditionalAttributes">
    @if (Name is not null && Values is not null)
    {
        foreach (var value in Values)
        {
            <input type="hidden" name="@Name" value="@value" />
        }
    }
    <HxButton Get="@Url"
              Target="@PanelSelector"
              Swap="HxSwap.InnerHtml"
              class="hx-dropdown-trigger"
              aria-haspopup="menu">@ChildContent</HxButton>
    <div id="@PanelId"
         class="hx-dropdown-panel"
         hx-get="@DismissUrl"
         hx-trigger="@CloseTrigger"
         hx-swap="@HxSwap.InnerHtml.ToAttributeValue()">@PanelContent</div>
</div>

@code {
    /// <summary>
    /// Name of the client event that closes every open dropdown. Fragment endpoints
    /// invoked by menu items can raise it with
    /// <c>TriggerClientEvent(HxDropdown.EventClose)</c> so the panel clears itself.
    /// </summary>
    public const string EventClose = "hx-dropdown-close";

    private static readonly string CloseTrigger = HxTrigger.On(EventClose).From("body");

    /// <summary>
    /// A dropdown opened by fetching a fragment (an <see cref="HxDropdownPanel"/>) into
    /// its panel. Closing is JavaScript-free: the panel clears itself with an empty swap,
    /// either from the transparent backdrop rendered by <see cref="HxDropdownPanel"/>
    /// (click outside) or when an <see cref="EventClose"/> event is raised through
    /// <c>HX-Trigger</c> (item selected). Map the empty endpoint once with
    /// <c>app.MapHxDismiss()</c>.
    /// For a <em>multi-select</em> dropdown, follow the self-swap pattern instead: each
    /// <see cref="HxDropdownItem"/> (with <see cref="HxDropdownItem.Selected"/> set) GETs
    /// the host fragment with the toggled selection, and the re-rendered host keeps the
    /// panel open by passing the same <see cref="HxDropdownPanel"/> through
    /// <see cref="PanelContent"/>. Set <see cref="Name"/>/<see cref="Values"/> so the
    /// selection travels as hidden inputs with any enclosing form.
    /// </summary>
    [Parameter, EditorRequired] public string Id { get; set; } = default!;

    /// <summary>Fragment endpoint URL serving the panel content.</summary>
    [Parameter, EditorRequired] public string Url { get; set; } = default!;

    /// <summary>Label of the trigger button.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Initial content of the panel, typically an <see cref="HxDropdownPanel"/>. Leave
    /// empty (default) for a closed dropdown; render it to ship the panel already open —
    /// e.g. when a multi-select host fragment re-renders itself after a toggle.
    /// </summary>
    [Parameter] public RenderFragment? PanelContent { get; set; }

    /// <summary>
    /// Name of the hidden inputs carrying <see cref="Values"/>, so the selection is
    /// submitted with any enclosing form. No hidden input is rendered when <c>null</c>.
    /// </summary>
    [Parameter] public string? Name { get; set; }

    /// <summary>Currently selected values of a multi-select dropdown (one hidden input each).</summary>
    [Parameter] public IReadOnlyCollection<string>? Values { get; set; }

    /// <summary>URL of the empty endpoint used to close the panel.</summary>
    [Parameter] public string DismissUrl { get; set; } = HxDismissEndpointExtensions.DefaultDismissRoute;

    private string PanelId => $"{Id}-panel";

    private string PanelSelector => $"#{PanelId}";
}
